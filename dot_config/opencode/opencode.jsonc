{
  "$schema": "https://opencode.ai/config.json",
  // Permissions — allow everything
  "permission": "allow",
  // Enable LSP for diagnostics & go-to-definition
  "lsp": true,
  // Enable code formatters
  "formatter": true,
  // Context compaction
  "compaction": {
    "auto": true,
    "prune": true
  },
  // MCP servers (add your servers here)
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  },
  // Custom instructions (add paths to project guidelines, etc.)
  "instructions": [],
  // File watcher — ignore noisy dirs
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "build/**"
    ]
  }
}
